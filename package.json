{
  "name": "topcoder-terms-api",
  "version": "1.0.0",
  "description": "TopCoder Terms V5 API",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "init-db": "node src/init-db.js",
    "test-data": "node src/test-data.js",
    "test": "nyc --reporter=html --reporter=text mocha test/unit/test.js --timeout 30000 --exit",
    "e2e": "nyc --reporter=html --reporter=text mocha test/e2e/test.js --timeout 30000 --exit",
    "test:dependency-compat": "node --test tools/minimatch-compat/index.test.cjs",
    "test:security": "node --test test/security/*.test.cjs"
  },
  "author": "TCSCODER",
  "license": "none",
  "devDependencies": {
    "mocha": "11.7.6",
    "nyc": "18.0.0",
    "should": "^13.2.3",
    "standard": "^17.1.0"
  },
  "dependencies": {
    "bluebird": "^3.7.2",
    "body-parser": "1.20.9",
    "config": "^3.3.11",
    "cors": "2.8.6",
    "docusign-esign": "8.7.0",
    "ejs": "^3.1.9",
    "express": "4.21.2",
    "express-interceptor": "^1.2.0",
    "get-parameter-names": "^0.3.0",
    "http-status-codes": "^2.3.0",
    "joi": "17.13.9",
    "lodash": "4.18.1",
    "pg": "8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "6.37.8",
    "superagent": "^8.1.2",
    "swagger-ui-express": "^5.0.0",
    "tc-core-library-js": "https://codeload.github.com/topcoder-platform/tc-core-library-js/tar.gz/a25576b8b038211d1ba910eca2d900271ba6659d",
    "uuid": "11.1.1",
    "winston": "^3.13.0",
    "yamljs": "^0.3.0"
  },
  "standard": {
    "env": [
      "mocha"
    ],
    "ignore": [
      "/docusign_callback"
    ]
  },
  "nyc": {
    "exclude": [
      "src/init-db.js",
      "src/test-data.js",
      "docusign_callback/*.js",
      "test/common/*.js",
      "test/unit/*.js",
      "test/e2e/*.js"
    ]
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "ajv@^6": "6.15.0",
    "axios": "1.20.0",
    "baseline-browser-mapping": "2.11.0",
    "body-parser": "$body-parser",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.8",
    "dottie": "2.0.7",
    "flatted": "3.4.2",
    "follow-redirects": "1.16.2",
    "form-data": "4.0.6",
    "joi": "$joi",
    "js-yaml@^3": "3.15.2",
    "js-yaml@^4": "4.3.2",
    "lodash": "$lodash",
    "minimatch@<9": "file:tools/minimatch-compat",
    "minimatch@>=9": "11.0.1",
    "glob@>=9": "14.0.2",
    "moment": "2.31.0",
    "path-to-regexp@^0.1": "0.1.13",
    "picomatch@^2": "2.3.2",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "serialize-javascript": "7.1.4",
    "underscore": "1.13.8",
    "uuid": "$uuid",
    "validator": "13.15.35"
  }
}
